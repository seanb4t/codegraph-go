tree\""},"path":{"type":"string","description":"Repo path (default: server cwd)"},"pattern":{"type":"string","description":"Shell glob narrowing the result set"}},"additionalProperties":false},"name":"codegraph_files"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Depth-bounded reverse blast radius of a symbol","inputSchema":{"type":"object","properties":{"depth":{"type":"integer","description":"BFS depth (default 2, max 50)"},"path":{"type":"string","description":"Repo path (default: server cwd)"},"symbol":{"type":"string","description":"Symbol name"}},"required":["symbol"],"additionalProperties":false},"name":"codegraph_impact"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Show a symbol's signature, calls, and callers, or a line-numbered file read","inputSchema":{"type":"object","properties":{"file":{"type":"string","description":"File path — disambiguates symbol, or selects file-mode when symbol is omitted"},"line":{"type":"integer","description":"Line number — narrows an overloaded symbol to the definition containing (or nearest) this line (NODE-03)"},"path":{"type":"string","description":"Repo path (default: server cwd)"},"symbol":{"type":"string","description":"Symbol name to look up (omit for a file-mode read)"}},"additionalProperties":false},"name":"codegraph_node"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Lexically search symbol names/qualified names, returning locations only","inputSchema":{"type":"object","properties":{"kind":{"type":"string","description":"Restrict to one node kind"},"limit":{"type":"integer","description":"Cap on results returned"},"path":{"type":"string","description":"Repo path (default: server cwd)"},"query":{"type":"string","description":"Search term"}},"required":["query"],"additionalProperties":false},"name":"codegraph_search"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Report index health and counts","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"Repo path (default: server cwd)"}},"additionalProperties":false},"name":"codegraph_status"}]}}
