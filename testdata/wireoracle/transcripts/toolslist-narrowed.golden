{"jsonrpc":"2.0","id":1,"result":{"capabilities":{"resources":{},"tools":{"listChanged":true}},"instructions":"codegraph indexes this repository's code into a call and symbol graph; try codegraph_explore first for a where-is-X or how-does-Y-work question, since it returns verbatim source plus call paths in one call. Every tool accepts an optional path argument; omitting it uses this server's own working directory. All eight tools register by default and appear automatically once an index exists, with no client restart required; an empty tool list means this repository has no index yet, so run codegraph init. Setting CODEGRAPH_MCP_TOOLS narrows the surface to the companions it names.","protocolVersion":"2025-11-25","serverInfo":{"name":"codegraph","version":"<VERSION>"}}}
{"jsonrpc":"2.0","id":2,"result":{"ttlMs":0,"cacheScope":"private","tools":[{"annotations":{"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Explore relevant symbols: verbatim source, call paths, blast radius","inputSchema":{"type":"object","properties":{"max_files":{"type":"integer","description":"Cap on distinct files returned (default 5)"},"path":{"type":"string","description":"Repo path (default: server cwd)"},"query":{"type":"string","description":"Natural-language or symbol/file query"}},"required":["query"],"additionalProperties":false},"name":"codegraph_explore"},{"annotations":{"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Show a symbol's signature, calls, and callers, or a line-numbered file read","inputSchema":{"type":"object","properties":{"file":{"type":"string","description":"File path — disambiguates symbol, or selects file-mode when symbol is omitted"},"line":{"type":"integer","description":"Line number — narrows an overloaded symbol to the definition containing (or nearest) this line (NODE-03)"},"path":{"type":"string","description":"Repo path (default: server cwd)"},"symbol":{"type":"string","description":"Symbol name to look up (omit for a file-mode read)"}},"additionalProperties":false},"name":"codegraph_node"},{"annotations":{"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Report index health and counts","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"Repo path (default: server cwd)"}},"additionalProperties":false},"name":"codegraph_status"}]}}
