.planning/research/.cache/

# Go build/test artifacts
/dist/
*.test
*.out
coverage.txt
coverage.html

# Local dev binary (produced by `go build -o codegraph ./cmd/codegraph`)
/codegraph

# Local dev binary (produced by `go build -o bin/codegraph ./cmd/codegraph`)
/bin/

# Local dev binary (produced by `go build ./tools/bench/gencorpus/`)
/gencorpus

# Local dev binary (produced by `go build ./tools/bench/runner/`)
/runner

# Local dev binary (produced by `go build ./testdata/golden/gocapture/...`)
/gocapture

# Local dev binary (produced by `go build ./tools/mcpaudit/...`)
/mcpaudit

# graphify skill scratch output
graphify-out/

# Generated knowledge-graph output — keep only the human-readable report
.planning/graphs/*
!.planning/graphs/GRAPH_REPORT.md

# Local TS/Go index data for the synthetic-parity golden fixture corpus
# (rebuilt by testdata/golden/capture.sh; never committed — same "local to
# each machine" convention as .codegraph/'s own nested .gitignore).
testdata/golden/corpus/*/src/.codegraph/

# Python bytecode (scripts/pr_template_policy.py)
__pycache__/
*.pyc

# GSD run-scoped dispatch-isolation sentinel (ephemeral session state)
.gsd/

# Local secret-reference file consumed via `op run --env-file=.env`.
# Holds 1Password `op://` references, never literal secrets — still never committed.
.env

# direnv local shell config (loads .env via dotenv_if_exists)
.envrc
